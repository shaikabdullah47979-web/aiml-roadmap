# Application Settings
PROJECT_NAME="AI/ML Roadmap & Academic Resource Management System"
API_V1_STR="/api/v1"
SECRET_KEY="generate-a-secure-random-32-byte-secret-key-here"
ALGORITHM="HS256"

# Database Configuration
# Local SQLite (Default for zero-setup local Windows development)
DATABASE_URL="sqlite:///./database/aiml_roadmap.db"

# PostgreSQL Configuration (Uncomment and edit credentials when PostgreSQL is running)
# DATABASE_URL="postgresql+psycopg2://postgres:your_password@localhost:5432/aiml_roadmap"

# Uploads Configuration (Max 50MB)
MAX_FILE_SIZE_BYTES=52428800

# Firebase Cloud Storage (Optional - provides cloud storage for materials)
# FIREBASE_CREDENTIALS_PATH="./serviceAccountKey.json"
# FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"

